<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Header ─────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SOS ACTIVE"
                android:textColor="#FF4444"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textEmergencyType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FF4444"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                tools:text="MEDICAL" />
        </LinearLayout>

        <!-- ── Mesh / location status ─────────────────────── -->
        <TextView
            android:id="@+id/textMeshRelayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            tools:text="Relayed via 3 peers" />

        <TextView
            android:id="@+id/textLocationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"
            tools:text="Approximate location shared (within 200 m)" />

        <!-- ── AI triage guidance ──────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI FIRST-AID GUIDANCE"
            android:textColor="#FF8800"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTriage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#22FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            tools:listitem="@android:layout/simple_list_item_1" />

        <!-- ── Responder card (hidden until assigned) ─────── -->
        <LinearLayout
            android:id="@+id/groupResponder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#22FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RESPONDER ASSIGNED"
                android:textColor="#44DD88"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textResponderName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="John Doe" />

                <ImageView
                    android:id="@+id/iconVerifiedBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/btn_star_big_on"
                    android:tint="#44DD88"
                    android:visibility="gone"
                    android:contentDescription="Verified responder" />
            </LinearLayout>

            <TextView
                android:id="@+id/textResponderTrustScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                tools:text="Trust score: 4.8 • 32 completed assists" />

            <TextView
                android:id="@+id/textResponderEta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF8800"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                tools:text="ETA: 4 min" />
        </LinearLayout>

        <!-- ── Hospital card (hidden until routed) ────────── -->
        <LinearLayout
            android:id="@+id/groupHospital"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#22FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECOMMENDED HOSPITAL"
                android:textColor="#4488FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textHospitalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="City General Hospital" />

            <TextView
                android:id="@+id/textHospitalReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                tools:text="Nearest trauma center with cardiac unit" />

            <TextView
                android:id="@+id/textHospitalDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#4488FF"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                tools:text="2.3 km away" />
        </LinearLayout>

        <!-- ── Action buttons ─────────────────────────────── -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonEscalate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ESCALATE TO EMERGENCY SERVICES"
            android:backgroundTint="#FF4444"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buttonCancelSos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel SOS"
            android:textColor="#AAAAAA"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>