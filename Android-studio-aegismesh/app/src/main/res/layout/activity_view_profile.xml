<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="My Profile"
            app:titleCentered="true"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Profile Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#0055FF" />

                    <TextView
                        android:id="@+id/textFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jane Doe"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A1C1E"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/textVerificationBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fully Verified"
                        android:textColor="#4CAF50"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#E8F5E9"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medical Data Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medical Profile"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0055FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Blood Group -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blood Group"
                        android:textSize="12sp"
                        android:textColor="#70777E" />
                    <TextView
                        android:id="@+id/textBloodGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="O+"
                        android:textSize="16sp"
                        android:textColor="#1A1C1E"
                        android:layout_marginBottom="12dp" />

                    <!-- Allergies -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allergies"
                        android:textSize="12sp"
                        android:textColor="#70777E" />
                    <TextView
                        android:id="@+id/textAllergies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peanuts, Penicillin"
                        android:textSize="16sp"
                        android:textColor="#1A1C1E"
                        android:layout_marginBottom="12dp" />

                    <!-- Chronic Illnesses -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chronic Conditions"
                        android:textSize="12sp"
                        android:textColor="#70777E" />
                    <TextView
                        android:id="@+id/textConditions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type 1 Diabetes"
                        android:textSize="16sp"
                        android:textColor="#1A1C1E"
                        android:layout_marginBottom="12dp" />

                    <!-- Medications -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Medications"
                        android:textSize="12sp"
                        android:textColor="#70777E" />
                    <TextView
                        android:id="@+id/textMedications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Insulin"
                        android:textSize="16sp"
                        android:textColor="#1A1C1E" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Update Profile"
                app:cornerRadius="16dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#0055FF" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
